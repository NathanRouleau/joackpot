{
  "expo": {
    "name": "JOAckpot",
    "slug": "joackpot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/joackpot_logo_full.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/joackpot_logo_full.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/joackpot_logo_full.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/joackpot_logo_full.png"
    }
  }
}
